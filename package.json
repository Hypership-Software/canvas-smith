{
  "name": "canvasmith",
  "private": true,
  "version": "0.1.0",
  "description": "Canvasmith — a Claude Code plugin that makes any AI-generated front-end look and feel Workday-native (via real Workday Canvas Kit references), plus its marketing site. Turborepo monorepo.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "web": "turbo run dev --filter=web"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
